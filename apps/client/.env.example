# Dev-server settings for the client. Copy this file to ".env" in the same folder if you need to change them:
#   Windows (cmd or PowerShell):  copy .env.example .env
#
# Where the Vite dev server / `vite preview` forwards "/api" requests.
# It must match HOST and PORT of apps/server (defaults: 127.0.0.1:3001).
# This value is read by vite.config.ts only and never reaches browser code.
DEV_API_PROXY_TARGET=http://127.0.0.1:3001

# Extra host names this dev server may answer to, comma separated. IP addresses and "localhost"
# always work; anything else (a PC name, a tunnel domain) must be listed or Vite refuses the request
# with 403 "Blocked request" as DNS-rebinding protection. Not needed for the default workflow.
# DEV_ALLOWED_HOSTS=my-pc.lan,.example.dev

# ----------------------------------------------------------------------------------------------
# Variables that DO reach browser code. Vite exposes only names starting with VITE_, and this app
# reads exactly one of them (validated in src/config/clientConfig.ts):
#
#   VITE_LOG_LEVEL   trace | debug | info | warn | error | fatal | silent
#
# Default when unset: "debug" in a dev build, "info" in a production build.
# SECURITY: everything here is bundled into the JavaScript sent to EVERY player's browser.
# Never put a secret, key or password in a VITE_ variable.
VITE_LOG_LEVEL=debug
