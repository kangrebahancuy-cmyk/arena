# Local overrides for the game server. Copy this file to ".env" in the same folder:
#   Windows (cmd or PowerShell):  copy .env.example .env
# Every variable is optional - the defaults below are what the server uses when nothing is set.
# Variables set in the real environment always win over this file.
#
# SECURITY: ".env" is git-ignored. Never commit it, and never move server secrets into apps/client
# (anything in the client is delivered to every player's browser).

# development | test | production
NODE_ENV=development

# Interface to listen on. 127.0.0.1 = this machine only (safe default).
# Use 0.0.0.0 only inside a container / on a server that sits behind a firewall or reverse proxy.
HOST=127.0.0.1
PORT=3001

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Trust X-Forwarded-* headers. Set to true ONLY when running behind a reverse proxy you control
# (nginx, Caddy, a load balancer...). Otherwise clients could spoof their IP and dodge rate limits.
TRUST_PROXY=false

# Global HTTP rate limit per client IP: at most MAX requests per WINDOW (milliseconds, minimum 1000).
HTTP_RATE_LIMIT_MAX=120
HTTP_RATE_LIMIT_WINDOW_MS=60000
