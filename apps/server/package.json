{
  "name": "@project-realm/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server: GameServer entry point, HTTP API and lifecycle today; game loop and WebSocket gateway from Phase 10.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
